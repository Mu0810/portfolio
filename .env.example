# Contact form email delivery (via Resend — https://resend.com)
# The contact form works without these, but will show a "email me directly"
# fallback until you configure them.

# 1. Create a free Resend account and API key, then paste it here:
RESEND_API_KEY=

# 2. Where contact-form messages are delivered (defaults to your address):
CONTACT_TO_EMAIL=0810sonimanish@gmail.com

# 3. The "from" address. The default shared sender works for testing.
#    For production, verify your own domain in Resend and use it here,
#    e.g. "Manish <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
